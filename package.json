{
    "name": "bilibili-downloader",
    "version": "1.2.4",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "test": "node --test test/account-popover-check.js test/multi-part-check.js && node test/js-media-check.js",
        "test:account": "node --test test/account-popover-check.js"
    },
    "keywords": [
        "bilibili",
        "downloader",
        "video"
    ],
    "author": {
        "name": "Ran",
        "email": "contact@5share.site",
        "url": "https://github.com/excpu"
    },
    "license": "AGPL",
    "description": "帮助你下载bilibili的视频",
    "devDependencies": {
        "cross-env": "^10.1.0",
        "electron": "39.8.10",
        "electron-builder": "^26.0.12"
    },
    "dependencies": {
        "got": "^11.8.6",
        "md5": "^2.3.0",
        "mp4box": "^2.5.0",
        "protobufjs": "^8.0.0"
    },
    "build": {
        "appId": "bilibili.downloader.app",
        "productName": "bilibili 视频下载工具",
        "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
        "directories": {
            "output": "dist"
        },
        "compression": "maximum",
        "electronLanguages": [
            "zh-CN",
            "zh-TW",
            "en-US"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false
        },
        "linux": {
            "category": "Utility",
            "icon": "build/icon.png",
            "maintainer": "Ran <contact@5share.site>",
            "target": [
                {
                    "target": "AppImage"
                },
                {
                    "target": "deb"
                },
                {
                    "target": "rpm"
                }
            ]
        },
        "mac": {
            "category": "public.app-category.utilities",
            "icon": "build/icon.icns",
            "target": [
                {
                    "target": "zip"
                }
            ]
        },
        "files": [
            "**/*",
            "!assets/doc{,/**/*}",
            "!assets/guide{,/**/*}",
            "!assets/sample{,/**/*}",
            "!images{,/**/*}",
            "!test{,/**/*}",
            "!web/deprecated{,/**/*}",
            "!assets/icon/Raw.png",
            "!web/assets/loading-placeholder.png",
            "!README.md",
            "!**/*.map",
            "!**/*.d.mts",
            "!**/*.d.cts",
            "!node_modules/protobufjs/dist{,/**/*}",
            "!node_modules/protobufjs/ext{,/**/*}"
        ]
    }
}
